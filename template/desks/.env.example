# Copy to desks/.env (never committed) and fill in.

# Who you are. Your work, locks and approvals are recorded under this name.
DESK_USER=

# Where the database is. Leave unset for a file on this machine (desks/data/desk.db).
# For a shared, hosted one: DESK_DB=https://<service>.up.railway.app (see kit/playbooks/hosting.md)
# DESK_DB=
# DESK_DB_TOKEN=

# Mail, for desks with a Mail: line: the project's mail Worker and its MAIL_API_TOKEN
# (kit/mail/README.md). `node desks/desk.mjs watch <desk>` listens with these.
# DESK_MAIL_URL=https://mail.<your-domain>
# DESK_MAIL_TOKEN=
